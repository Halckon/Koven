fun main(): Unit {
    var m = mutableMapOf<String, Int>()
    m.put("b", 2); m.put("a", 1); m.put("b", 5)
    val old = m.remove("a")
    m.put("a", 7)
    var i = 0; var ok = true
    for ((k, v) in m) {
        if (i == 0 && (k != "b" || v != 5)) { ok = false }
        if (i == 1 && (k != "a" || v != 7)) { ok = false }
        i = i + 1
    }
    if (ok && i == 2 && old != null) { println("map-reorder") }
}
