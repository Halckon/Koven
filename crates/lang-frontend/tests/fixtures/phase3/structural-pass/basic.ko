class Resource {}
value class Pair<A, B>(val first: A, val second: B)
fun inspect(borrow item: Resource): Unit {}
fun pass(copy: Pair<Int, Int>, moved: Pair<Resource, Int>): Unit {
    val (first, second) = copy
    val stillAvailable = copy
    val borrowed = inspect(moved.first)
    val copied = moved.second
}
