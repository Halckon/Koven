public class Service(private val logger: Logger): Logger by logger {
    override fun log(message: String): Unit {}

    companion object {
        const val VERSION: Int = 1
        fun create(logger: Logger): Service = Service(logger)
    }
}

enum class Outcome<T, E> {
    Ok(item: T),
    Err(error: E);

    fun isOk(): Boolean = true
}
