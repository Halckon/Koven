// Ordinary successful values only. Bounds are explicit, not derived by bit shifts.
fun convert0(value: Byte): Byte = value.toByte()
fun check0(): Boolean {
    val low: Byte = convert0(-128)
    val expectedlow: Byte = -128
    val high: Byte = convert0(127)
    val expectedhigh: Byte = 127
    val zero: Byte = convert0(0)
    val expectedzero: Byte = 0
    val one: Byte = convert0(1)
    val expectedone: Byte = 1
    return low == expectedlow && high == expectedhigh && zero == expectedzero && one == expectedone
}
