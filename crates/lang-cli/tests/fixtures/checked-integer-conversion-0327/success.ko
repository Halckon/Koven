fun tick(): Int { println("tick"); return 1 }
fun acceptOwned(own label: String, value: Long): Unit {
    println(label)
    if (value == 7L) { println("owned-ok") } else { println("bad-owned") }
}
fun acceptBorrow(label: String, value: Long): Unit {
    println(label)
    if (value == 7L) { println("borrow-ok") } else { println("bad-borrow") }
}
fun checkResources(number: Int): Unit {
    val retained = "retained"
    val retainedValue: Long = number.toLong()
    println(retained)
    if (retainedValue == 7L) { println("retained-ok") } else { println("bad-retained") }
    acceptOwned("pending-owned", number.toLong())
    val borrowed = "borrowed"
    acceptBorrow(borrowed, number.toLong())
    println(borrowed)
}
