fun fullBreakLong(): Unit {
    for (item in -9223372036854775808L..9223372036854775807L) {
        if (item == -9223372036854775808L) { println("long.full.break.first") }
        else { println("UNEXPECTED.long.full.break") }
        break
    }
    println("long.full.break.done")
}

fun fullReturnLong(): Long {
    for (item in -9223372036854775808L..9223372036854775807L) {
        println("long.full.return.first")
        return item
    }
    return 0L
}

fun observeLong(input: LongRange): LongRange {
    println("long.snapshot.source")
    return input
}

fun snapshotLong(): Unit {
    var current = 2L..4L
    for (item in observeLong(current)) {
        current = 9L..9L
        if (item == 2L) { println("long.snapshot.first") }
        else {
            if (item == 3L) { println("long.snapshot.second") }
            else {
                if (item == 4L) { println("long.snapshot.last") }
                else { println("UNEXPECTED.long.snapshot.item") }
            }
        }
        continue
    }
    if (current == (9L..9L)) { println("long.snapshot.reassigned") }
    else { println("UNEXPECTED.long.snapshot.source.after") }
}

fun resourceNormalLong(): Unit {
    val outer = Resource("long.normal.outer.drop")
    for (_ in 1L..2L) {
        val first = Resource("long.normal.first.drop")
        val second = Resource("long.normal.second.drop")
        println("long.normal.body")
    }
    println("long.normal.after")
}

fun resourceContinueLong(): Unit {
    val outer = Resource("long.continue.outer.drop")
    for (_ in 1L..2L) {
        val first = Resource("long.continue.first.drop")
        val second = Resource("long.continue.second.drop")
        println("long.continue.body")
        continue
    }
    println("long.continue.after")
}

fun resourceBreakLong(): Unit {
    val outer = Resource("long.break.outer.drop")
    for (_ in 1L..3L) {
        val first = Resource("long.break.first.drop")
        val second = Resource("long.break.second.drop")
        println("long.break.body")
        break
    }
    println("long.break.after")
}

fun returnOperandLong(input: Long): Long {
    println("long.return.operand")
    return input
}

fun resourceReturnLong(): Long {
    val outer = Resource("long.return.outer.drop")
    for (item in 1L..3L) {
        val first = Resource("long.return.first.drop")
        val second = Resource("long.return.second.drop")
        println("long.return.body")
        return returnOperandLong(item)
    }
    return 0L
}

fun numericInsideListLong(values: List<Int>): Unit {
    for (value in values) {
        val outer = Resource("long.inside.outer.drop")
        for (item in 1L..2L) {
            if (value == 7) {
                if (item == 1L) { println("long.inside.first") }
                else {
                    if (item == 2L) { println("long.inside.last") }
                    else { println("UNEXPECTED.long.inside.item") }
                }
            } else { println("UNEXPECTED.long.inside.borrow") }
            continue
        }
        if (value == 7) { println("long.inside.borrow.after") }
        else { println("UNEXPECTED.long.inside.borrow.after") }
    }
    println("long.inside.done")
}

fun listInsideNumericLong(values: List<Int>): Unit {
    for (item in 1L..2L) {
        val outer = Resource("long.outside.outer.drop")
        for (value in values) {
            if (value == 7) { println("long.outside.borrow") }
            else { println("UNEXPECTED.long.outside.borrow") }
            break
        }
        if (item == 1L) { println("long.outside.first.after") }
        else {
            if (item == 2L) { println("long.outside.last.after") }
            else { println("UNEXPECTED.long.outside.item") }
        }
        continue
    }
    println("long.outside.done")
}

fun runLong(values: List<Int>): Unit {
    emptyLong()
    maximumLong()
    fullBreakLong()
    if (fullReturnLong() == -9223372036854775808L) { println("long.full.return.done") }
    else { println("UNEXPECTED.long.full.return.value") }
    snapshotLong()
    resourceNormalLong()
    resourceContinueLong()
    resourceBreakLong()
    if (resourceReturnLong() == 1L) { println("long.return.done") }
    else { println("UNEXPECTED.long.return.value") }
    numericInsideListLong(values)
    listInsideNumericLong(values)
}

fun main(): Unit {
    val values = listOf(7)
    runInt(values)
    runLong(values)
    println("numeric.iteration.done")
}
