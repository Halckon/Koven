fun checkpoint(m: MutableMap<Int, Int>, own step: Int): Unit {
    if (m.size >= 0) { println("checkpoint") }
}
fun entry(): Unit {
    var m = mutableMapOf<Int, Int>()
    checkpoint(m, 0)
    m.put(0, 100)
    checkpoint(m, 1)
    m.put(5, 105)
    checkpoint(m, 2)
    m.put(10, 110)
    checkpoint(m, 3)
    m.remove(0)
    checkpoint(m, 4)
    m.put(5, 205)
    checkpoint(m, 5)
    m.put(0, 200)
    checkpoint(m, 6)
    if (m.size == 3 && m.get(5) == 205 && m.get(0) == 200) { println("values") }
    println("done")
}
