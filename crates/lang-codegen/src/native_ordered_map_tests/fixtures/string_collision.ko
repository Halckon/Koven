fun checkpoint(m: MutableMap<String, Int>, own step: Int): Unit {
    if (m.size >= 0) { println("checkpoint") }
}
fun entry(): Unit {
    var m = mutableMapOf<String, Int>()
    checkpoint(m, 0)
    m.put("a".clone(), 100)
    checkpoint(m, 1)
    m.put("q".clone(), 105)
    checkpoint(m, 2)
    m.put("A".clone(), 110)
    checkpoint(m, 3)
    m.remove("a")
    checkpoint(m, 4)
    m.put("q".clone(), 205)
    checkpoint(m, 5)
    m.put("a".clone(), 200)
    checkpoint(m, 6)
    if (m.size == 3 && m.get("q") == 205 && m.get("a") == 200) { println("values") }
    println("done")
}
