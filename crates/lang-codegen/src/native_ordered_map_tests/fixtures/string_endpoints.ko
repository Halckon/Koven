fun checkpoint(m: MutableMap<String, Int>, own step: Int): Unit {
    if (m.size >= 0) { println("checkpoint") }
}
fun entry(): Unit {
    var m = mutableMapOf<String, Int>()
    checkpoint(m, 0)
    m.put("9".clone(), 90)
    checkpoint(m, 1)
    m.put("1".clone(), 10)
    checkpoint(m, 2)
    m.put("7".clone(), 70)
    checkpoint(m, 3)
    m.put("3".clone(), 30)
    checkpoint(m, 4)
    m.remove("9")
    checkpoint(m, 5)
    m.remove("7")
    checkpoint(m, 6)
    m.remove("3")
    checkpoint(m, 7)
    m.remove("1")
    checkpoint(m, 8)
    m.remove("99")
    checkpoint(m, 9)
    if (m.size == 0) { println("values") }
    println("done")
}
