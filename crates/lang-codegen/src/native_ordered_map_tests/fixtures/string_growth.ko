fun checkpoint(m: MutableMap<String, Int>, own step: Int): Unit {
    if (m.size >= 0) { println("checkpoint") }
}
fun entry(): Unit {
    var m = mutableMapOf<String, Int>()
    checkpoint(m, 0)
    m.put("9".clone(), 90)
    checkpoint(m, 1)
    m.put("1".clone(), 10)
    checkpoint(m, 2)
    m.put("7".clone(), 70)
    checkpoint(m, 3)
    m.put("3".clone(), 30)
    checkpoint(m, 4)
    m.put("11".clone(), 110)
    checkpoint(m, 5)
    m.put("5".clone(), 50)
    checkpoint(m, 6)
    m.put("0".clone(), 0)
    checkpoint(m, 7)
    m.put("13".clone(), 130)
    checkpoint(m, 8)
    m.put("2".clone(), 20)
    checkpoint(m, 9)
    m.put("15".clone(), 150)
    checkpoint(m, 10)
    m.put("4".clone(), 40)
    checkpoint(m, 11)
    m.put("9".clone(), 999)
    checkpoint(m, 12)
    if (m.size == 11 && m.get("9") == 999) { println("values") }
    println("done")
}
