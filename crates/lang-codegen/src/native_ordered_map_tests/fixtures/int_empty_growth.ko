fun checkpoint(m: MutableMap<Int, Int>, own step: Int): Unit {
    if (m.size >= 0) { println("checkpoint") }
}
fun entry(): Unit {
    var m = mutableMapOf<Int, Int>()
    checkpoint(m, 0)
    m.put(9, 90)
    checkpoint(m, 1)
    m.put(1, 10)
    checkpoint(m, 2)
    m.put(7, 70)
    checkpoint(m, 3)
    m.put(3, 30)
    checkpoint(m, 4)
    m.put(11, 110)
    checkpoint(m, 5)
    m.put(5, 50)
    checkpoint(m, 6)
    m.put(0, 0)
    checkpoint(m, 7)
    m.put(13, 130)
    checkpoint(m, 8)
    m.put(2, 20)
    checkpoint(m, 9)
    m.put(15, 150)
    checkpoint(m, 10)
    m.put(4, 40)
    checkpoint(m, 11)
    m.remove(9)
    checkpoint(m, 12)
    m.remove(1)
    checkpoint(m, 13)
    m.remove(7)
    checkpoint(m, 14)
    m.remove(3)
    checkpoint(m, 15)
    m.remove(11)
    checkpoint(m, 16)
    m.remove(5)
    checkpoint(m, 17)
    m.remove(0)
    checkpoint(m, 18)
    m.remove(13)
    checkpoint(m, 19)
    m.remove(2)
    checkpoint(m, 20)
    m.remove(15)
    checkpoint(m, 21)
    m.remove(4)
    checkpoint(m, 22)
    m.put(99, 990)
    checkpoint(m, 23)
    if (m.size == 1 && m.get(99) == 990) { println("values") }
    println("done")
}
