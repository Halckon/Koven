fun <T> view(source: String, own other: T): borrow String from source = source
class OwnedResource { deinit() { println("drop-owned") } }
class BorrowedResource { deinit() { println("drop-borrowed") } }
fun consume(own source: String) { println(source) }
fun entry() { val source = "kept".clone(); borrow val item = view(source, OwnedResource()); println(item); consume(source) }
