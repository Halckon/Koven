class Left { deinit() { println("drop-left") } }
class Right { deinit() { println("drop-right") } }
fun left(): Left { println("eval-left"); return Left() }
fun right(): Right { println("eval-right"); return Right() }
fun view(own left: Left, source: String, own right: Right): borrow String from source = source
fun consume(own source: String) { println(source) }
fun entry() { val source = "kept".clone(); borrow val item = view(right = right(), source = source, left = left()); println(item); consume(source) }
