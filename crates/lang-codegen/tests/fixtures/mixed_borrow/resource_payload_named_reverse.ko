class Resource(val text: String) { deinit() { println(this.text) } }
fun view(own left: Resource, source: String, own right: Resource): borrow String from source = source
fun consume(own source: String) { println(source) }
fun entry() { val source = "kept".clone(); borrow val item = view(right = Resource("right".clone()), source = source, left = Resource("left".clone())); println(item); consume(source) }
