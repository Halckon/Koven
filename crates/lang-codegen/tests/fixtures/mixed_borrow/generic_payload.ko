class Resource(val text: String) { deinit() { println(this.text) } }
fun <T> leaf(own left: T, source: String, own right: T): borrow String from source = source
fun <T> wrap(own left: T, source: String, own right: T): borrow String from source = leaf(right = right, source = source, left = left)
fun requireValue(actual: Int, expected: Int) { if (actual == expected) { println("copy-kept") } else { error("copy changed") } }
fun consume(own source: String) { println(source) }
fun entry() { val source = "source-payload".clone(); val left = 13; val right = 29; borrow val first = wrap(right = right, source = source, left = left); requireValue(left, 13); requireValue(right, 29); println(first); borrow val second = wrap(right = Resource("right".clone()), source = source, left = Resource("left".clone())); println(second); consume(source) }
