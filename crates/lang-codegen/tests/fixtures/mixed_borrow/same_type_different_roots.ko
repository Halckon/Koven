fun view(other: String, source: String, own transferred: String): borrow String from source = source
fun consume(own source: String) { println(source) }
fun entry() { val other = "other".clone(); val source = "kept".clone(); val transferred = "transferred".clone(); borrow val item = view(transferred = transferred, source = source, other = other); println(item); consume(other); consume(source) }
