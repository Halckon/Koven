class OwnedResource { deinit() { println("drop-owned") } }
fun view(source: String, own other: OwnedResource): borrow String from source = source
fun consume(own source: String) { println(source) }
fun entry() { val source = "kept".clone(); borrow val item = view(source, OwnedResource()); borrow val alias = item; println(alias); println(item); consume(source) }
