class OwnedResource { deinit() { println("drop-owned") } }
class BorrowedResource { deinit() { println("drop-borrowed") } }
fun view(other: OwnedResource, source: String): borrow String from source = source
fun wrap(own other: OwnedResource, source: String): borrow String from source = view(other, source)
fun consume(own source: String) { println(source) }
fun entry() { val source = "kept".clone(); borrow val item = wrap(OwnedResource(), source); println(item); consume(source) }
