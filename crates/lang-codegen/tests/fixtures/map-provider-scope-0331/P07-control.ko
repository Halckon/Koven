fun argument():Int{println("argument");return 1}
fun produce(input:Int):Map<String,String>{if(input!=1){error("bad-input")};println("factory");var result=mutableMapOf<String,String>();result.put("key".clone(),"value".clone());val output=result.consume();return output}
fun make():Map<String,String>{return produce(argument())}
fun makeMutable():MutableMap<String,String>{var result=mutableMapOf<String,String>();result.put("key".clone(),"value".clone());return result}
fun read(key:String,value:String):Unit{println(key);println(value)}
fun observe(source:Map<String,String>):Unit{if(source.size==1){println("control")}else{error("bad-size")}}
fun observeMutable(source:MutableMap<String,String>):Unit{if(source.size==1){println("control")}else{error("bad-size")}}
fun scan(flag:Boolean):Unit{var source=make();if(flag){source=make()};observe(source);observe(source)}
fun entry():Unit{scan(true);scan(false)}
