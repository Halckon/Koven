value class Text(val word: String)
fun stringDirect(stop: Int): String {
    var cache = mutableMapOf<Int, String>()
    val keys = arrayOf(1, 2, 3)
    for (key in keys) {
        cache.put(key, "head".clone())
        val result = "returned".clone()
        if (key == stop) { return result }
        println("tail")
    }
    return "fallback".clone()
}
fun stringGroup(stop: Int): String {
    var cache = mutableMapOf<Int, String>()
    val keys = arrayOf(1, 2, 3)
    for (key in keys) {
        cache.put(key, "head".clone())
        val result = "returned".clone()
        if (key == stop) { return (result) }
        println("tail")
    }
    return "fallback".clone()
}
fun valueDirect(stop: Int): Text {
    var cache = mutableMapOf<Int, String>()
    val keys = arrayOf(1, 2, 3)
    for (key in keys) {
        cache.put(key, "head".clone())
        val result = Text("returned".clone())
        if (key == stop) { return result }
        println("tail")
    }
    return Text("fallback".clone())
}
fun valueGroup(stop: Int): Text {
    var cache = mutableMapOf<Int, String>()
    val keys = arrayOf(1, 2, 3)
    for (key in keys) {
        cache.put(key, "head".clone())
        val result = Text("returned".clone())
        if (key == stop) { return (result) }
        println("tail")
    }
    return Text("fallback".clone())
}
fun main(): Unit {
    println(stringDirect(1))
    println(stringDirect(3))
    println(stringDirect(9))
    println(stringGroup(1))
    println(stringGroup(3))
    println(stringGroup(9))
    { val (word) = valueDirect(1); println(word) }
    { val (word) = valueDirect(3); println(word) }
    { val (word) = valueDirect(9); println(word) }
    { val (word) = valueGroup(1); println(word) }
    { val (word) = valueGroup(3); println(word) }
    { val (word) = valueGroup(9); println(word) }
}
