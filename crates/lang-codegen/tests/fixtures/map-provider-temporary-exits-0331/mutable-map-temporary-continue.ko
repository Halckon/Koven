class Guard { deinit() { println("local-drop") } }
fun read(key: String, value: String): Unit {
  println(key)
  println(value)
}
fun makeMutable(): MutableMap<String, String> {
  println("make-mutable-nonempty")
  var source = mutableMapOf<String, String>()
  source.put("z".clone(), "first".clone())
  source.put("a".clone(), "second".clone())
  return source
}
fun makeEmptyMutable(): MutableMap<String, String> {
  println("make-mutable-empty")
  var source = mutableMapOf<String, String>()
  return source
}
fun entry(): Unit {
  println("nonempty")
  for ((key, value) in makeMutable()) {
    val local = Guard()
    read(key, value)
    continue
  }
  println("after-nonempty")
  println("empty")
  for ((key, value) in makeEmptyMutable()) {
    val local = Guard()
    read(key, value)
    continue
  }
  println("after-empty")
}
