class Guard { deinit() { println("local-drop") } }
fun read(key: String, value: String): Unit {
  println(key)
  println(value)
}
fun makeMap(): Map<String, String> {
  println("make-map-nonempty")
  var source = mutableMapOf<String, String>()
  source.put("z".clone(), "first".clone())
  source.put("a".clone(), "second".clone())
  val result = source.consume()
  return result
}
fun makeEmptyMap(): Map<String, String> {
  println("make-map-empty")
  var source = mutableMapOf<String, String>()
  val result = source.consume()
  return result
}
fun operand(key: String, value: String): Int {
  println("operand")
  read(key, value)
  return 7
}
fun scanNonempty(): Int {
  for ((key, value) in makeMap()) {
    val local = Guard()
    return operand(key, value)
  }
  println("exhausted")
  return 0
}
fun scanEmpty(): Int {
  for ((key, value) in makeEmptyMap()) {
    val local = Guard()
    return operand(key, value)
  }
  println("exhausted")
  return 0
}
fun entry(): Unit {
  println("nonempty")
  val result = scanNonempty()
  if (result == 7) { println("returned-7") } else { println("unexpected-nonempty-result") }
  println("empty")
  val emptyResult = scanEmpty()
  if (emptyResult == 0) { println("returned-0") } else { println("unexpected-empty-result") }
}
