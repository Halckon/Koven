fun inspect(own initial: Rc<Int>?): Rc<Int>? {
    var owner: Rc<Int>? = initial
    while (owner != null) {
        println("continue-body")
        owner = null
        continue
    }
    return owner
}

fun readResult(own owner: Rc<Int>?): Boolean {
    return owner == null
}

fun entry(): Unit {
    val present: Rc<Int>? = Rc(41)
    val presentResult = readResult(inspect(present))
    if (presentResult == true) { println("continue-present-ok") } else { println("continue-present-bad") }
    val absent: Rc<Int>? = null
    val absentResult = readResult(inspect(absent))
    if (absentResult == true) { println("continue-null-ok") } else { println("continue-null-bad") }
}
