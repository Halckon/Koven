fun inspect(own owner: Rc<Int>?): Rc<Int>? {
    while (owner != null) {
        println("return-body")
        return owner
    }
    return owner
}

fun readResult(own owner: Rc<Int>?): Int {
    if (owner != null) { return owner.value }
    return -1
}

fun entry(): Unit {
    val present: Rc<Int>? = Rc(41)
    val presentResult = readResult(inspect(present))
    if (presentResult == 41) { println("return-present-ok") } else { println("return-present-bad") }
    val absent: Rc<Int>? = null
    val absentResult = readResult(inspect(absent))
    if (absentResult == -1) { println("return-null-ok") } else { println("return-null-bad") }
}
