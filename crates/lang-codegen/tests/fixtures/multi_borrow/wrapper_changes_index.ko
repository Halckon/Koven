fun view(other: String, source: String): borrow String from source = source
fun wrap(source: String, other: String): borrow String from source = view(source = source, other = other)
fun consume(own source: String) { println(source) }
fun entry() { val source = "kept".clone(); val other = "other".clone(); borrow val item = wrap(other = other, source = source); consume(other); println(item); consume(source) }
