class Guard(val name: String) { deinit() { println(this.name) } }

fun operand(item: String): Int { println(item); println("operand"); return 7 }
fun cleanup(stop: Boolean): Int {
    val outer = Guard("outer")
    var cache = mutableMapOf<Int, String>()
    for (item in arrayOf("first".clone(), "second".clone())) {
        val first = Guard("earlier")
        val second = Guard("later")
        cache.put(1, "head".clone())
        if (stop) { return operand(item) }
        cache.put(9, "tail".clone())
        println("fallthrough")
    }
    if (cache.contains(9)) { println("tail kept") }
    println("exhausted")
    return 0
}
