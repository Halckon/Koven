fun read(key: String, value: String): Unit {
  println(key)
  println(value)
}
fun makeMutable(): MutableMap<String, String> {
  var source = mutableMapOf<String, String>()
  source.put("z".clone(), "first".clone())
  source.put("a".clone(), "second".clone())
  return source
}
fun scan(source: MutableMap<String, String>): Unit {
  for ((key, value) in source) {
    read(key, value)
  }
  println("exhausted")
}
fun entry(): Unit {
  println("nonempty")
  val populated = makeMutable()
  scan(populated)
  println("empty")
  val empty = mutableMapOf<String, String>()
  scan(empty)
}
