value class Text(val word: String)

fun removeDead(keys: Array<Int>, stop: Int): Unit {
    var cache = mutableMapOf<Int, String>()
    cache.put(1, "value".clone())
    for (key in keys) {
        val removed = cache.remove(key)
        val present = removed != null
        if (present) { println("present") } else { println("missing") }
        if (key == stop) { break }
    }
    println("dead")
}

fun removeLive(keys: Array<Int>, stop: Int): Unit {
    var cache = mutableMapOf<Int, String>()
    cache.put(1, "value".clone())
    for (key in keys) {
        val removed = cache.remove(key)
        val present = removed != null
        if (present) { println("present") } else { println("missing") }
        if (key == stop) { break }
    }
    if (cache.contains(1)) { println("retained") } else { println("removed") }
    cache.put(2, "tail".clone())
    if (cache.contains(2)) { println("tail present") } else { println("tail missing") }
    val tail = cache.remove(2)
    if (tail != null) { println("tail removed") } else { println("tail missing") }
    println("live")
}

fun putDead(keys: Array<Int>, stop: Int): Unit {
    var words = mutableMapOf<String, Text>()
    for (key in keys) {
        words.put("key".clone(), Text("value".clone()))
        if (words.contains("key")) { println("put") } else { println("missing put") }
        if (key == stop) { break }
    }
    println("dead")
}

fun putLive(keys: Array<Int>, stop: Int): Unit {
    var words = mutableMapOf<String, Text>()
    for (key in keys) {
        words.put("key".clone(), Text("value".clone()))
        if (words.contains("key")) { println("put") } else { println("missing put") }
        if (key == stop) { break }
    }
    if (words.contains("key")) { println("retained") } else { println("empty") }
    words.put("tail".clone(), Text("tail".clone()))
    if (words.contains("tail")) { println("tail present") } else { println("tail missing") }
    println("live")
}

fun main(): Unit {
    removeDead(arrayOf<Int>(), 1)
    removeDead(arrayOf(1, 1, 2, 3), 1)
    removeDead(arrayOf(1, 1, 2, 3), 2)
    removeDead(arrayOf(1, 1, 2), 9)
    removeLive(arrayOf<Int>(), 1)
    removeLive(arrayOf(1, 1, 2, 3), 1)
    removeLive(arrayOf(1, 1, 2, 3), 2)
    removeLive(arrayOf(1, 1, 2), 9)
    putDead(arrayOf<Int>(), 1)
    putDead(arrayOf(1, 1, 2, 3), 1)
    putDead(arrayOf(1, 1, 2, 3), 2)
    putDead(arrayOf(1, 1, 2), 9)
    putLive(arrayOf<Int>(), 1)
    putLive(arrayOf(1, 1, 2, 3), 1)
    putLive(arrayOf(1, 1, 2, 3), 2)
    putLive(arrayOf(1, 1, 2), 9)
}
