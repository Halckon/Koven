class Source(val text: String) { deinit() { println("drop-source") } }
fun view(source: Source): borrow String from source = source.text
fun wrap(source: Source): borrow String from source = view(source)
fun wrapAgain(source: Source): borrow String from source = wrap(source)
fun observe(source: String) { println(source) }
fun consume(own source: Source) { println("consume-source") }
fun entry() { val source = Source("field".clone()); observe(wrapAgain(source)); consume(source) }
