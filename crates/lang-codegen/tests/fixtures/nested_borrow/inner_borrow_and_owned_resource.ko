class Aux { deinit() { println("drop-aux") } }
class Temp { deinit() { println("drop-temp") } }
fun view(temp: Temp, source: String, own aux: Aux): borrow String from source = source
fun observe(source: String) { println(source) }
fun consume(own source: String) { println(source) }
fun entry() { val source = "kept".clone(); observe(view(aux = Aux(), source = source, temp = Temp())); consume(source) }
