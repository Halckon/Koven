class Aux { deinit() { println("drop-aux") } }
class Temp { deinit() { println("drop-temp") } }
fun view(source: String): borrow String from source = source
fun observe(temp: Temp, source: String, own aux: Aux) { println(source) }
fun consume(own source: String) { println(source) }
fun entry() { val source = "kept".clone(); borrow val item = view(source); observe(Temp(), item, Aux()); println("after"); consume(source) }
