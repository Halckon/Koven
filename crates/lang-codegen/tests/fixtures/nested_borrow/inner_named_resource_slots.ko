class Aux(val tag: String) { deinit() { println(this.tag) } }
fun view(own left: Aux, source: String, own right: Aux): borrow String from source = source
fun left(): Aux { println("eval-left"); return Aux("drop-left") }
fun right(): Aux { println("eval-right"); return Aux("drop-right") }
fun observe(source: String) { println(source) }
fun consume(own source: String) { println(source) }
fun entry() { val source = "kept".clone(); observe(view(right = right(), source = source, left = left())); consume(source) }
