fun read(key: String, value: String): Unit {
  println(key)
  println(value)
}
fun makeMap(): Map<String, String> {
  var source = mutableMapOf<String, String>()
  source.put("z".clone(), "first".clone())
  source.put("a".clone(), "second".clone())
  val result = source.consume()
  return result
}
fun scan(source: Map<String, String>): Unit {
  for ((outerKey, outerValue) in source) {
    println("outer")
    read(outerKey, outerValue)
    for ((innerKey, innerValue) in source) {
      println("pair")
      read(outerKey, outerValue)
      read(innerKey, innerValue)
    }
    println("after-inner")
    read(outerKey, outerValue)
  }
  println("exhausted")
  if (source.size == 2) { println("scan-size-2") }
  if (source.size == 0) { println("scan-size-0") }
}
fun entry(): Unit {
  println("nonempty")
  val populated = makeMap()
  scan(populated)
  if (populated.size == 2) { println("caller-size-2") }
  println("empty")
  val empty = mapOf<String, String>()
  scan(empty)
  if (empty.size == 0) { println("caller-size-0") }
}
