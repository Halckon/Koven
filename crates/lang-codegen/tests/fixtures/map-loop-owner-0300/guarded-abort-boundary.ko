value class Text(val word: String)

fun removeDead(keys: Array<Int>): Unit {
    var cache = mutableMapOf<Int, String>()
    cache.put(1, "value".clone())
    for (key in keys) {
        val removed = cache.remove(key)
        val present = removed != null
        if (present) { println("present") } else { println("missing") }
    }
    println("dead")
}

fun removeLive(keys: Array<Int>): Unit {
    var cache = mutableMapOf<Int, String>()
    cache.put(1, "value".clone())
    for (key in keys) {
        val removed = cache.remove(key)
        val present = removed != null
        if (present) { println("present") } else { println("missing") }
    }
    if (keys.size == 0) {
        if (!cache.contains(1)) { error("zero-iteration owner lost") }
    } else {
        if (cache.contains(1)) { error("removed entry returned") }
    }
    cache.put(2, "tail".clone())
    if (!cache.contains(2)) { error("post-loop put lost") }
    val tail = cache.remove(2)
    if (tail == null) { error("post-loop remove lost") }
    println("live")
}

fun putDead(keys: Array<Int>): Unit {
    var words = mutableMapOf<String, Text>()
    for (key in keys) {
        words.put("key".clone(), Text("value".clone()))
        if (!words.contains("key")) { error("loop put lost") }
        if (key == 1) { println("put") }
    }
    println("dead")
}

fun putLive(keys: Array<Int>): Unit {
    var words = mutableMapOf<String, Text>()
    for (key in keys) {
        words.put("key".clone(), Text("value".clone()))
        if (!words.contains("key")) { error("loop put lost") }
        if (key == 1) { println("put") }
    }
    if (keys.size == 0) {
        if (words.contains("key")) { error("zero-iteration entry appeared") }
    } else {
        if (!words.contains("key")) { error("post-loop owner lost") }
    }
    words.put("tail".clone(), Text("tail".clone()))
    if (!words.contains("tail")) { error("post-loop put lost") }
    println("live")
}

fun main(): Unit {
    removeDead(arrayOf<Int>())
    removeDead(arrayOf(1))
    removeDead(arrayOf(1, 1, 1))
    removeLive(arrayOf<Int>())
    removeLive(arrayOf(1))
    removeLive(arrayOf(1, 1, 1))
    putDead(arrayOf<Int>())
    putDead(arrayOf(1))
    putDead(arrayOf(1, 1, 1))
    putLive(arrayOf<Int>())
    putLive(arrayOf(1))
    putLive(arrayOf(1, 1, 1))
}
