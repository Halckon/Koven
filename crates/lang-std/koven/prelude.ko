// Koven 标准声明与仓库 bootstrap entries；compiler-bound identity 由标准分析环境发布。
value class Pair<A, B>(val first: A, val second: B)

fun bootstrapSmoke(): Unit {}

fun bootstrapHello(): Unit {
    println("Hello, World!")
}

fun bootstrapPairResult(): Unit {
    val pair = Pair(20, 22)
    val copied = pair
    val (left, right) = pair
    if (left + right != 42) { error("bad Pair destructuring") }
    if (copied.first + copied.second != 42) { error("bad Pair copy") }

    // Result/Ok/Err 来自内建环境（koven/core/result.ko），不在本文件声明。
    val ok: Result<Int, Int> = Ok(7)
    val success: Int = when (ok) {
        is Ok -> ok.success
        is Err -> 0
    }
    if (success != 7) { error("bad Result.Ok") }

    val err: Result<Int, Int> = Result.Err(9)
    val failure: Int = when (err) {
        is Result.Ok<Int, Int> -> 0
        is Result.Err<Int, Int> -> err.error
    }
    if (failure != 9) { error("bad Result.Err") }
}

fun bootstrapAbort(): Unit {
    error("standard error abort smoke")
}
