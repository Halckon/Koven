      "sources": {
        "project.toml": "schema = \"koven.project\"\nversion = 1\n[project]\nname = \"generic-container\"\nsource-roots = [\"src\"]\n",
        "src/p/library.ko": "package p\nfun <T> sizeOf(items: Array<T>): Int = ((items)).size\nfun <T> pass(own items: Array<T>): Array<T> = items\n",
        "src/q/main.ko": "package q\nfun entry(): Unit {\n    val empty: Array<Int> = arrayOf()\n    val ints = arrayOf(1, 2)\n    val strings = arrayOf(\"one\", \"two\")\n    if (p.sizeOf<Int>(empty) != 0) { error(\"empty\") }\n    if (p.sizeOf(ints) != 2) { error(\"Int\") }\n    if (p.sizeOf<String>(strings) != 2) { error(\"String\") }\n    if (p.sizeOf(strings) != 2) { error(\"repeat Borrow\") }\n    if (strings.size != 2) { error(\"reuse\") }\n    val movedInts = p.pass<Int>(ints)\n    val movedStrings = p.pass(strings)\n    if (movedInts.size != 2) { error(\"Int own return\") }\n    if (p.sizeOf(movedStrings) != 2) { error(\"String own return\") }\n    println(\"ok\")\n}\n"
      },
