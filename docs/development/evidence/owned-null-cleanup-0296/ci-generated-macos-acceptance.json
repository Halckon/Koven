      "minimal_source": "// 资源程序：UTF-8 span witness\nclass Leaf(val name: String) { deinit() { println(this.name) } }\nfun inspect(item: Leaf): Unit { println(\"borrow\"); println(item.name) }\nfun consume(own item: Leaf): Unit { println(\"consume\") }\nclass Holder(var state: Leaf) { deinit() { println(\"drop:holder\") } }\nfun work(own stop: Boolean): Unit {\n    val holder = Holder(Leaf(\"drop:a\"))\n    val old = replace(&holder.state, Leaf(\"drop:b\"))\n    inspect(old)\n    if (stop) { return }\n    println(\"helper-done\")\n}\nfun entry(): Unit { work(true); println(\"done\") }\n",
