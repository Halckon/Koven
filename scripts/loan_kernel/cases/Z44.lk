// Z44（§82）：1A 裸借用参数显式取址禁止、into v.origins 拒绝与 .origins/.* 区分，以及 1A 闭包捕获两栏对照。

class Item(x: Int)
class Pair(a: Item, b: Item)

view class Slot(inout p: Item)
view class DualView(borrow a: Item, borrow b: Item)
view class NamedOrigins(borrow origins: Item)

// 1A 闭包捕获建模（SharedCap 仅验证持有者权限；真实普通闭包返回报 L0137 须独立测试，未在本文件覆盖）：
view class SharedCap(borrow target: Item)
view class ExclCap(inout target: Item)

fun read_item(borrow x: Item): Unit trusted
fun write_item(inout x: Item): Unit trusted
fun write_slot(inout s: Slot): Unit trusted
fun <view T> take_view_mut(inout x: T): Unit trusted
fun copy_all_origins(borrow src: DualView, inout out: DualView): Unit flows src.origins into out trusted
fun set_field_a(borrow src: Item, inout out: DualView): Unit flows src into out.a trusted

// ---- 1. 裸借用参数显式取址（1A）vs 实参重借、字段投影与显式槽位

fun bare_borrow_ref_rejected(borrow h: Item): Unit {
    val r1 = &h           // ERR TYPE
    val r2 = &mut h       // ERR TYPE
    use(r1)
    use(r2)
}

fun bare_inout_ref_rejected(inout h: Item): Unit {
    val r1 = &h           // ERR TYPE
    val r2 = &mut h       // ERR TYPE
    use(r1)
    use(r2)
}

fun write_bare_vs_ref_distinct_diagnostics(borrow h: Item): Unit {
    write_item(h)         // ERR K1
    write_item(&mut h)    // ERR TYPE
}

fun bare_reborrow_and_field_projection_ok(borrow hb: Pair, inout hm: Pair): Unit {
    val fa = &hb.a
    val fb = &mut hm.b
    read_item(fa)
    write_item(fb)
    read_item(&hb.b)
    write_item(&mut hm.a)
}

fun bare_param_reborrow_ok(borrow hb: Item, inout hm: Item): Unit {
    read_item(hb)
    read_item(hm)
    write_item(hm)
}

fun explicit_view_slot_ok(inout h: Item): Unit {
    val s = Slot(h)
    write_slot(&mut s)
    write_item(h)
}

// OD1 · A1（1A-ext）已将禁止裸借用绑定槽显式取址扩展至局部借用绑定（默认 local_borrow_ref_policy="forbid"）；
// 当前原型按 check_unique 禁止同名遮蔽，不改检查器。
fun local_borrow_alias_ref_scope_undecided(borrow hb: Pair, inout hm: Pair): Unit {
    val fa = &hb.a
    val fb = &mut hm.b
    val ra = &fa          // ERR TYPE
    val rb = &mut fb      // ERR TYPE
    use(ra)
    use(rb)
}

// ---- 2. 封堵 <view T> 后门：不能用裸 borrow/inout 参数绕过 1A

fun generic_view_t_backdoor_rejected(borrow hb: Item, inout hm: Item): Unit {
    take_view_mut(&mut hb) // ERR TYPE
    take_view_mut(&mut hm) // ERR TYPE
    take_view_mut(hb)      // ERR K1
    take_view_mut(hm)
}

// ---- 3. p.origins vs .* 区分、真实 origins 字段撞名与禁止 into v.origins 静默漏记

fun origins_selector_ambiguous(borrow v: NamedOrigins): borrow Item from v.origins { // ERR SIG
    return v.origins
}

fun star_selector_no_origins_collision_ok(borrow v: NamedOrigins): borrow Item from v.* {
    return v.origins
}

fun origins_field_normal_access_ok(borrow v: NamedOrigins): borrow Item from v {
    return v.origins
}

fun flow_into_origins_target_rejected(borrow s: Item, inout v: DualView): Unit flows s into v.origins { // ERR SIG
    use(s)
    use(v.a)
}

fun flow_into_star_target_rejected(borrow s: Item, inout v: NamedOrigins): Unit flows s into v.* { // ERR SIG
    use(s)
    use(v.origins)
}

fun flows_origins_source_blocks_conflicting_write(): Unit {
    val x = Item(1)
    val y = Item(2)
    val z = Item(3)
    val src = DualView(&x, &y)
    val out = DualView(&z, &z)
    copy_all_origins(&src, &mut out)
    write_item(&mut x)    // ERR K1
    read_item(out.a)
}

fun flows_real_field_target_blocks_conflicting_write(): Unit {
    val x = Item(1)
    val y = Item(2)
    val out = DualView(&y, &y)
    set_field_a(&x, &mut out)
    write_item(&mut x)    // ERR K1
    read_item(out.a)
}

// ---- 4A. 1A 闭包捕获（现行 Guide 07 共享捕获持有者权限对照）

fun closure_capture_guide07_shared_ok(inout h: Item): Unit {
    val cap = SharedCap(h)
    read_item(h)          // 捕获活跃时外部共享读仍合法
    read_item(cap.target)
    write_item(h)
}

fun closure_capture_guide07_shared_mut_rejected(inout h: Item): Unit {
    val cap = SharedCap(h)
    write_item(cap.target) // ERR K1
}

fun closure_capture_guide07_shared_conflict(inout h: Item): Unit {
    val cap = SharedCap(h)
    write_item(h)          // ERR K4
    read_item(cap.target)
}

// ---- 4B. 1A 闭包捕获（未来内核独占捕获持有者权限对照）

fun closure_capture_future_excl_ok(inout h: Item): Unit {
    val cap = ExclCap(h)
    write_item(cap.target)
    write_item(h)
}

fun closure_capture_future_excl_conflict(inout h: Item): Unit {
    val cap = ExclCap(h)
    read_item(h)           // ERR K4
    write_item(cap.target)
}

fun closure_capture_future_excl_from_borrow_rejected(borrow h: Item): Unit {
    val cap = ExclCap(h)   // ERR K1
    use(cap)
}
