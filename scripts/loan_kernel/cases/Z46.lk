// Z46（§84）：局部借用变量显式取址（val fa = &hb.a; &fa / &mut fa）三策略对照实验。
// 本文件中的错误标记对应 OD1 · A1 收口后的默认策略 local_borrow_ref_policy="forbid"（1A-ext）；
// 旧扁平化基线 "undecided"（6 处漏报）与候选二层借用 "second_order" 的精确逐行差异在
// scripts/tests/test_loan_kernel.py::test_local_borrow_address_of_policy_contrast 中对照断言。

class Item(x: Int)
class Pair(a: Item, b: Item)
view class Slot(inout p: Item)

fun read_item(borrow x: Item): Unit trusted
fun write_item(inout x: Item): Unit trusted
fun write_int(inout x: Int): Unit trusted
fun write_slot(inout s: Slot): Unit trusted
fun <T> take_escapable_mut(inout x: T): Unit trusted
fun <view T> take_view_mut(inout x: T): Unit trusted
fun <view T> copy_inner(borrow x: T): T from x.origins trusted

// ---- 1. 旧默认（undecided）暴露的六处扁平化类型漏洞（forbid 与 second_order 均堵住）

// 漏洞 1：fa 是只读共享借用（borrow Item），但 undecided 将 &mut fa 扁平化为 inout Item 并放行写操作！
// - undecided:    接受（漏报）
// - forbid:       TYPE（禁止对局部借用变量显式取址）
// - second_order: TYPE（二层借用 inout (borrow Item) 不能充当 inout Item）
fun local_borrow_write_via_mut_ref_hole(borrow hb: Pair): Unit {
    val fa = &hb.a
    write_item(&mut fa) // ERR TYPE
    read_item(fa)
}

// 漏洞 2：fa 是不可逃逸的 borrow Item，但 undecided 将 &mut fa 扁平化为 Item 后绕过 <T> 可逃逸上界！
// - undecided:    接受（漏报）
// - forbid:       TYPE
// - second_order: K17（borrow Item 可能携带来源，不能实例化可逃逸类型参数 T）
fun local_borrow_escapable_t_hole(borrow hb: Pair): Unit {
    val fa = &hb.a
    take_escapable_mut(&mut fa) // ERR TYPE
    read_item(fa)
}

// 漏洞 3：经 *rb = Item(9) 向 borrow Item 槽位写入非借用值：
// - undecided:    接受（漏报，因 rb 被扁平化为 inout Item）
// - forbid:       val rb = &mut fa 报 TYPE
// - second_order: *rb = Item(9) 报 X1（不能把 Item 写入 borrow Item 槽位）
fun local_borrow_store_concrete_into_borrow_slot(): Unit {
    val a = Item(1)
    val fa = &a
    val rb = &mut fa   // ERR TYPE
    *rb = Item(9)
    read_item(fa)
}

// 漏洞 4（标量形参）：val n = 1; val r = &n; write_int(&mut r)
// - undecided:    接受（漏报，&mut r 被扁平化为 inout Int）
// - forbid:       TYPE
// - second_order: TYPE（二层借用 inout (borrow Int) 不能充当 inout Int）
fun local_borrow_scalar_write_via_mut_ref_hole(): Unit {
    val n = 1
    val r = &n
    write_int(&mut r)  // ERR TYPE
    use(r)
}

// 漏洞 5（视图构造器消除一层借用）：val fa = &a; val s = Slot(&mut fa); write_item(s.p)
// - undecided:    接受（漏报，Slot(&mut fa) 接受扁平化的 inout Item）
// - forbid:       TYPE（禁止对局部借用取址）
// - second_order: TYPE（Slot.p 要求 inout Item，不能接收二层借用 inout (borrow Item)）
fun local_borrow_view_constructor_peel_hole(): Unit {
    val a = Item(1)
    val fa = &a
    val s = Slot(&mut fa) // ERR TYPE
    write_item(s.p)
}

// 漏洞 6（二层借用 .origins 传递内层来源）：val g = copy_inner(&fa)
// - undecided:    &fa 扁平化为 borrow Item 使 T = Item，g 变成拥有值，write_item(&mut a) 不报 K1，read_item(g) 报 TYPE
// - forbid:       val g = copy_inner(&fa) 报 TYPE，随后 read_item(g) 报 TYPE
// - second_order: T = borrow Item，g 为 borrow Item，write_item(&mut a) 报 K1，read_item(g) 合法
fun local_borrow_origins_preserves_inner_loan(): Unit {
    val a = Item(1)
    val fa = &a
    val g = copy_inner(&fa) // ERR TYPE
    write_item(&mut a)
    read_item(g)            // ERR TYPE
}

// ---- 2. 局部借用变量取址的其余对照行为

// 对局部 inout 变量取 &mut fm 并传给 write_item(inout Item)：
// - undecided:    接受（误扁平化为 inout Item）
// - forbid:       TYPE
// - second_order: TYPE（二层借用 inout (inout Item) 不能充当 inout Item）
fun local_inout_write_via_mut_ref(inout hm: Pair): Unit {
    val fm = &mut hm.b
    write_item(&mut fm) // ERR TYPE
    write_item(fm)
}

// 对局部 borrow 变量取 &fa 并传给 read_item(borrow Item)：
// - undecided:    接受（误扁平化为 borrow Item）
// - forbid:       TYPE
// - second_order: TYPE（二层借用 borrow (borrow Item) 不能充当 borrow Item）
fun local_borrow_read_via_ref(borrow hb: Pair): Unit {
    val fa = &hb.a
    read_item(&fa)      // ERR TYPE
    read_item(fa)
}

// 传给 <view T> 泛型 inout T：
// - undecided:    接受（T = Item）
// - forbid:       TYPE（彻底封堵 <view T> 后门）
// - second_order: 接受（T = borrow Item，满足 view T 但不满足可逃逸 T）
fun local_borrow_view_t_contrast(borrow hb: Pair): Unit {
    val fa = &hb.a
    take_view_mut(&mut fa) // ERR TYPE
    read_item(fa)
}

// 经二层借用 *rb = &b 重绑定局部借用槽 fa：
// - undecided:    *rb = &b 报 X1（未更新 fa 的账，写旧来源 a 仍报 K1）
// - forbid:       val rb = &mut fa 报 TYPE，*rb = &b 报 X1，写旧来源 a 仍报 K1
// - second_order: *rb = &b 接受并将新来源 b 记入 fa，旧来源 a 已解除可写
fun local_borrow_rebind_via_second_order_store(): Unit {
    val a = Item(1)
    val b = Item(2)
    val fa = &a
    val rb = &mut fa   // ERR TYPE
    *rb = &b           // ERR X1
    write_item(&mut a) // ERR K1
    read_item(fa)
}

// 经二层借用 *rb = &b 重绑后，fa 仍活时写新来源 b：
// - undecided:    *rb = &b 报 X1；未更新 fa 的账，写 b 不报 K1
// - forbid:       val rb = &mut fa 报 TYPE；*rb = &b 报 X1
// - second_order: *rb = &b 接受；随后 write_item(&mut b) 报 K1（新来源受保护）
fun local_borrow_rebind_protects_new_source(): Unit {
    val a = Item(1)
    val b = Item(2)
    val fa = &a
    val rb = &mut fa   // ERR TYPE
    *rb = &b           // ERR X1
    write_item(&mut b)
    read_item(fa)
}

// 二层共享借用 ra = &fa 存活期间，阻断重绑 fa：
// - undecided:    fa = &b 报 K1
// - forbid:       val ra = &fa 报 TYPE
// - second_order: fa = &b 报 K1
fun local_borrow_ref_blocks_rebind(): Unit {
    val a = Item(1)
    val b = Item(2)
    val fa = &a
    val ra = &fa       // ERR TYPE
    fa = &b
    use(ra)
}

// 二层共享借用 ra = &fa 存活期间，经 K3 传递保活 fa 从而继续阻断写底层来源 a（即使后续不再直接使用 fa）：
// - undecided:    write_item(&mut a) 报 K1
// - forbid:       val ra = &fa 报 TYPE
// - second_order: write_item(&mut a) 报 K1
fun local_borrow_ref_keeps_source_alive(): Unit {
    val a = Item(1)
    val fa = &a
    val ra = &fa       // ERR TYPE
    write_item(&mut a)
    use(ra)
}

// 返回 &fa（即便签名声明了 from hb）：
// - undecided:    K6（引用指向局部槽 fa）
// - forbid:       TYPE（禁止对局部借用取址）
// - second_order: TYPE + K6（类型不匹配且指向局部槽 fa）
fun local_borrow_ref_cannot_return(borrow hb: Pair): borrow Item from hb {
    val fa = &hb.a
    return &fa         // ERR TYPE
}

// ---- 3. 三种策略下行为完全一致的正反例

fun local_borrow_reborrow_and_field_proj_ok(borrow hb: Pair, inout hm: Pair): Unit {
    val fa = &hb.a
    val fm = &mut hm.b
    read_item(fa)
    read_item(fm)
    write_item(fm)
    val fx = &fa.x
    val fmx = &mut fm.x
    use(fx)
    use(fmx)
    val s = Slot(fm)
    write_slot(&mut s)
}

fun local_borrow_direct_write_still_k1(borrow hb: Pair): Unit {
    val fa = &hb.a
    write_item(fa)     // ERR K1
}
