// C8：四值判定（yes/no/unknown/error）、interface 上界与可推导也可声明的能力（Equatable）
interface Plain
interface Sendable : Transferable
interface EqSendable : Transferable + Equatable

class Point(x: Int, y: Int) is Plain, Sendable, EqSendable
class LocalTask(r: Rc<Int>) is Plain
class BadSendable(r: Rc<Int>) is Sendable  // ERR

// 含不可推导 Equatable 字段（RawPtr）的类型：默认不可 Equatable，但可安全 impl Equatable
class RawKey(p: RawPtr<Int>)
class CustomKey(p: RawPtr<Int>) impl Equatable
class BoxedKey<T>(item: T, p: RawPtr<Int>) impl Equatable if T: Equatable
// 不可安全声明的结构能力（Transferable）写 impl 须报声明错误
class BadImplTransfer(r: Rc<Int>) impl Transferable  // ERR

class Runner<T: Sendable>(task: T)
class NeedsTransfer<T: Transferable>(item: T)
class ForwardSendable<T: Sendable>(r: Runner<T>, n: NeedsTransfer<T>)

// 一、可推导也可声明的能力（Equatable）
expect Equatable Point = yes
expect Equatable RawKey = no
expect Equatable CustomKey = yes
expect Equatable BoxedKey = if T: Equatable
expect Equatable BoxedKey<CustomKey> = yes
expect Equatable BoxedKey<RawKey> = no

// 二、interface 上界与 any I 存在类型能力
expect Transferable any Sendable = yes
expect Transferable any Plain = no
expect Equatable any EqSendable = yes
expect Equatable any Sendable = no
expect wf Runner<Point> = yes
expect wf Runner<LocalTask> = no
expect wf Runner<any Sendable> = yes
expect wf Runner<any Plain> = no
expect wf ForwardSendable<Point> = yes

// 三、四值判定：yes / no / unknown / error（错误恢复不崩溃）
expect judge Transferable Point = yes
expect judge Transferable LocalTask = no
expect judge Transferable <T> Box<T> = unknown
expect judge Transferable <T: Transferable> Box<T> = yes
expect judge Transferable <T: Sendable> Box<T> = yes
expect judge Equatable <T: Sendable> Box<T> = unknown
expect judge Equatable <T: EqSendable> Box<T> = yes
expect judge Transferable Box<MissingType> = error
expect judge Transferable List<Int, Int> = error
expect judge UnknownCap Point = error
